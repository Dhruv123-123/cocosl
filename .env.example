# ---------------------------------------------------------------------------
# Content Factory configuration. Copy to .env and fill in what you use.
# Nothing here is required to run the offline demo.
# See docs/CREDENTIALS.md for how to get each value.
# ---------------------------------------------------------------------------

# Safety switch. 1 = never call publishing APIs (default). Set to 0 only after a test post.
FACTORY_DRY_RUN=1

# Dashboard password. Required before you expose the dashboard beyond localhost.
DASHBOARD_TOKEN=

# --- Writing (Claude) -------------------------------------------------------
# auto = Claude when ANTHROPIC_API_KEY is set, else offline placeholders
FACTORY_LLM=auto
ANTHROPIC_API_KEY=
FACTORY_MODEL=claude-opus-5-5
FACTORY_EFFORT=medium

# --- Voice ------------------------------------------------------------------
# auto | piper | espeak | elevenlabs | openai | silent. Use your own voice or a licensed one.
FACTORY_TTS=auto
PIPER_MODEL=
ESPEAK_VOICE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
OPENAI_API_KEY=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# --- Images -----------------------------------------------------------------
# auto | comfyui | openai | replicate | cards
FACTORY_IMAGES=auto
COMFYUI_URL=
COMFYUI_CHECKPOINT=
COMFYUI_TIMEOUT=
OPENAI_IMAGE_QUALITY=
REPLICATE_API_TOKEN=
# Optional folder of royalty-free / licensed music tracks for background audio
FACTORY_MUSIC_DIR=

# --- Media hosting ----------------------------------------------------------
# Instagram/Threads/TikTok-pull fetch media from a public HTTPS URL.
# Point this at wherever output/ is served (e.g. https://media.yourdomain.com).
PUBLIC_MEDIA_BASE_URL=

# --- Instagram (Meta Graph API, Business/Creator account) -------------------
IG_USER_ID=
IG_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# --- Facebook Page ----------------------------------------------------------
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- Threads ----------------------------------------------------------------
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- YouTube (Data API v3, OAuth installed app) -----------------------------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# private = you flip videos public yourself after a final look
YT_PRIVACY=private

# --- TikTok (Content Posting API) -------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Unaudited apps can only post SELF_ONLY (private)
TIKTOK_PRIVACY=SELF_ONLY

# --- Postiz (optional: delegate scheduling to self-hosted Postiz) -----------
POSTIZ_URL=
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_IDS=

# --- Business (UGC ad studio, invoices, outreach drafts) ---------------------
FACTORY_MONTHLY_GOAL=1000
FACTORY_SENDER_NAME=
FACTORY_SENDER_BUSINESS=
FACTORY_SENDER_EMAIL=
FACTORY_SENDER_WEBSITE=
# Required by CAN-SPAM on every outreach email (a PO box or registered agent address works)
FACTORY_SENDER_ADDRESS=
FACTORY_PORTFOLIO_URL=
FACTORY_PAYMENT_INSTRUCTIONS=
# Public base URL for tracked affiliate links (/go/<slug>), e.g. https://links.yourdomain.com
FACTORY_LINK_BASE_URL=
# 0 = skip PDF rendering (HTML only)
FACTORY_PDF=1

# --- Token bookkeeping (written by `factory auth`, leave blank) ---------------
TIKTOK_TOKEN_EXPIRES_AT=
IG_TOKEN_EXPIRES_AT=
THREADS_TOKEN_EXPIRES_AT=
# Instagram Login instead of Facebook Login: set to graph.instagram.com
IG_API_HOST=
