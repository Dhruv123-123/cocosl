# ---------------------------------------------------------------------------
# Content Factory configuration. Copy to .env and fill in what you use.
# Nothing here is required to run the offline demo.
# See docs/CREDENTIALS.md for how to get each value.
# ---------------------------------------------------------------------------

# Safety switch. 1 = never call publishing APIs (default). Set to 0 only after a test post.
FACTORY_DRY_RUN=1

# Dashboard password. Required before you expose the dashboard beyond localhost.
DASHBOARD_TOKEN=

# --- Writing (Claude) -------------------------------------------------------
# auto = Claude when ANTHROPIC_API_KEY is set, else offline placeholders
FACTORY_LLM=auto
ANTHROPIC_API_KEY=
FACTORY_MODEL=claude-opus-5-5
FACTORY_EFFORT=medium

# --- Voice ------------------------------------------------------------------
# auto | kokoro | piper | espeak | elevenlabs | openai | silent. Use your own voice or a licensed one.
FACTORY_TTS=auto
# Kokoro (free, open weights): docker compose --profile kokoro up -d, then KOKORO_URL=http://kokoro:8880
# (http://localhost:8880 outside Docker). Or pip install ".[kokoro]" to run it in-process.
KOKORO_URL=
KOKORO_VOICE=af_heart          # e.g. af_heart, af_bella, am_michael, bf_emma, bm_george
KOKORO_SPEED=1.0
# RENDER_QUEUE=1 hands renders to the renderer service (set for you in docker-compose.yml)
PIPER_MODEL=
ESPEAK_VOICE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
OPENAI_API_KEY=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=

# --- Images -----------------------------------------------------------------
# auto | comfyui | openai | replicate | cards
FACTORY_IMAGES=auto
COMFYUI_URL=
COMFYUI_CHECKPOINT=
COMFYUI_TIMEOUT=
OPENAI_IMAGE_QUALITY=
REPLICATE_API_TOKEN=
# Optional folder of royalty-free / licensed music tracks for background audio
FACTORY_MUSIC_DIR=

# --- Media hosting ----------------------------------------------------------
# Instagram/Threads/TikTok-pull fetch media from a public HTTPS URL.
# Point this at wherever output/ is served (e.g. https://media.yourdomain.com).
PUBLIC_MEDIA_BASE_URL=

# --- Instagram (Meta Graph API, Business/Creator account) -------------------
IG_USER_ID=
IG_ACCESS_TOKEN=
# Post Reels as Trial Reels (shown to non-followers first). SS_PERFORMANCE graduates winners
# to followers automatically; MANUAL leaves it to you in the app. Blank = normal Reels.
IG_TRIAL_REELS=
META_APP_ID=
META_APP_SECRET=

# --- Facebook Page ----------------------------------------------------------
FB_PAGE_ID=
FB_PAGE_TOKEN=

# --- Threads ----------------------------------------------------------------
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- YouTube (Data API v3, OAuth installed app) -----------------------------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# private = you flip videos public yourself after a final look
YT_PRIVACY=private
YT_UPLOAD_CAPTIONS=1           # upload the voice-timed captions as a YouTube caption track (0 = off)

# --- TikTok (Content Posting API) -------------------------------------------
# TikTok is post-by-hand: the worker writes a package (video, caption, time) instead of uploading,
# because TikTok doesn't allow tools that post to your own accounts. `factory manual` / the Today page.
# Comma list of platforms handled this way. Only clear it if you run an audited app for other creators.
MANUAL_PLATFORMS=tiktok,pinterest
# The keys below are only for TikTok login/metrics or an audited multi-creator app.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
# Unaudited apps can only post SELF_ONLY (private)
TIKTOK_PRIVACY=SELF_ONLY

# --- Postiz (optional: delegate scheduling to self-hosted Postiz) -----------
POSTIZ_URL=
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_IDS=

# --- Business (UGC ad studio, invoices, outreach drafts) ---------------------
FACTORY_MONTHLY_GOAL=1000
FACTORY_SENDER_NAME=
FACTORY_SENDER_BUSINESS=
FACTORY_SENDER_EMAIL=
FACTORY_SENDER_WEBSITE=
# Required by CAN-SPAM on every outreach email (a PO box or registered agent address works)
FACTORY_SENDER_ADDRESS=
FACTORY_PORTFOLIO_URL=
FACTORY_PAYMENT_INSTRUCTIONS=
# Public base URL for tracked affiliate links (/go/<slug>), e.g. https://links.yourdomain.com
FACTORY_LINK_BASE_URL=
# 0 = skip PDF rendering (HTML only)
FACTORY_PDF=1

# --- Token bookkeeping (written by `factory auth`, leave blank) ---------------
TIKTOK_TOKEN_EXPIRES_AT=
IG_TOKEN_EXPIRES_AT=
THREADS_TOKEN_EXPIRES_AT=
# Instagram Login instead of Facebook Login: set to graph.instagram.com
IG_API_HOST=

# --- Funnel: link page, email list, payments ---------------------------------
# Public https base for the link page, signup form, confirm/unsubscribe links
FUNNEL_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Printed in every newsletter (CAN-SPAM); required to send for real
BUSINESS_ADDRESS=
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
GUMROAD_PING_SECRET=
FUNNEL_RATE_LIMIT=5
FUNNEL_TRUST_PROXY=0

# --- Funnel extras ---
SUPPORT_EMAIL=                 # reply-to shown in welcome emails and sales pages
SEQUENCES_EVERY=60             # worker: minutes between welcome-sequence runs

# --- Comment inbox ---
COMMENTS_EVERY=60              # worker: minutes between comment collection runs (0 = off)
IG_USERNAME=                   # optional: your IG handle, so your own comments are skipped
YT_CHANNEL_ID=                 # optional: your YouTube channel id, same reason

# --- Ad studio proposals & portfolio ---
FACTORY_PORTFOLIO_URL=         # where the sample-ads portfolio is hosted
FACTORY_PAYMENT_INSTRUCTIONS=  # e.g. "Pay by Stripe link in the invoice email"

# --- Worker timing (defaults shown) ---
PUBLISH_EVERY=10               # minutes between publishing passes
METRICS_EVERY=6                # hours between metrics snapshots
DAILY_AT=07:00                 # default local time for each brand's daily drafts (brand cadence.daily_at wins)
PUBLISH_LATE_HOURS=6           # a post more than this late (worker was down) moves to the next free slot instead of bursting
RENDER_STALE_MINUTES=120       # a render job stuck this long is retried
BACKUP_DIR=                    # set (e.g. /data/backups or a mounted bucket) and the worker backs up the database daily
BACKUP_KEEP=14
CLEANUP_AFTER_DAYS=            # e.g. 60: the worker deletes videos/audio of posts live that long (thumbnails, captions kept)

# --- Second brand on its own accounts ---
# Prefix any platform key with the brand slug in capitals (dashes -> underscores) and two underscores.
# `factory auth <platform> --brand tiny-histories` writes these for you.
# TINY_HISTORIES__IG_USER_ID=
# TINY_HISTORIES__IG_ACCESS_TOKEN=
# TINY_HISTORIES__YT_REFRESH_TOKEN=
# TINY_HISTORIES__TIKTOK_ACCESS_TOKEN=
FACTORY_TRIM_SILENCE=1         # cut dead air at the start/end of each voiced segment
FACTORY_VAD=                   # "silero" = use Silero VAD for that (pip install silero-vad); default is an energy check
# Images: with ComfyUI use FLUX.1 [schnell] (Apache-2.0), e.g. COMFYUI_CHECKPOINT=flux1-schnell-fp8.safetensors.
# FLUX.1 [dev] weights are non-commercial and are refused.
# Charts: segments with a `chart` are drawn from the script's exact numbers (no AI image).
FACTORY_PREFLIGHT=1            # check media against each platform's limits before scheduling and upload (0 = off)
FACTORY_CHARTS=                # "manim" = animate them in videos (pip install manim; needs cairo/pango); default is a still
