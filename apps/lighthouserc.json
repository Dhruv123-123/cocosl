{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "numberOfRuns": 1,
      "url": [
        "http://localhost/index.html",
        "http://localhost/es/index.html",
        "http://localhost/app/index.html",
        "http://localhost/budget/index.html",
        "http://localhost/budget/split-bills.html",
        "http://localhost/budget/wedding-budget.html",
        "http://localhost/money-calculators/take-home-pay/index.html",
        "http://localhost/scam-checker/index.html",
        "http://localhost/scam-checker/app/index.html",
        "http://localhost/scam-checker/app/checklist.html",
        "http://localhost/scam-checker/app/report.html",
        "http://localhost/freelance-invoices/app/index.html",
        "http://localhost/freelance-invoices/app/quarterly.html"
      ],
      "settings": { "chromeFlags": "--no-sandbox --headless=new", "onlyCategories": ["accessibility", "best-practices", "seo", "performance"] }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.8 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
