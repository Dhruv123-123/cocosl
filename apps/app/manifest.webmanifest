    { "name": "Split bills", "url": "../budget/split-bills.html", "icons": [{ "src": "../budget/icon-192.png", "sizes": "192x192" }] },
    { "name": "Scam check", "url": "../scam-checker/", "icons": [{ "src": "../budget/icon-192.png", "sizes": "192x192" }] }
  ]
